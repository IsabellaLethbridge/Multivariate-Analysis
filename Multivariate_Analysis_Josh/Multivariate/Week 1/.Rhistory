x = seq(-5,5,0.01)
f <- function(x) exp(-x^2 / 2) * sin(2 * x)^2
y = f(x)
plot(y ~ x, type = "l", ylim = c(0,1))
## 2
C = 2.7
h <- function(x)dnorm(x,0,1)
hx = C * h(x)
lines(hx ~ x, type = "l", col = "red")
genN <- function(N){
uniformX = runif(N,0,1)
candidateX = rnorm(N,0,1)
return(list(uniX = uniformX, candX = candidateX))
}
N = 10000
## 4
uniformX = genN(N)$uniX
candidateX = genN(N)$candX
gx = f(candidateX) / (C * h(candidateX))
## 5
accept = candidateX[uniformX <= gx]
hist(accept, prob = T, ylim = c(0,0.6))
hist(accept, prob = T, ylim = c(0,0.6), breaks = 50)
trueY = f(accept)
lines(accept, trueY / integrate(f, -Inf, Inf)$value,
type = "l", col = "red")
# Question 1
## 1
x = seq(-5,5,0.01)
f <- function(x) exp(-x^2 / 2) * sin(2 * x)^2
y = f(x)
plot(y ~ x, type = "l", ylim = c(0,1))
## 2
C = 2.7
h <- function(x)dnorm(x,0,1)
hx = C * h(x)
lines(hx ~ x, type = "l", col = "red")
## 3
genN <- function(N){
uniformX = runif(N,0,1)
candidateX = rnorm(N,0,1)
return(list(uniX = uniformX, candX = candidateX))
}
N = 10000
## 4
uniformX = genN(N)$uniX
candidateX = genN(N)$candX
gx = f(candidateX) / (C * h(candidateX))
## 5
accept = candidateX[uniformX <= gx]
##6
hist(accept, prob = T, ylim = c(0,0.6), breaks = 50)
# Need to order both X and Y so its not random mismatch of lines
ord = order(accept)
accept = accept[ord]
trueY = f(accept)
# The integarte part is used to scale the line
lines(accept, trueY / integrate(f, -Inf, Inf)$value,
type = "l", col = "red")
