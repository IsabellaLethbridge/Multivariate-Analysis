N = 1000
X = runif(N, -1, 1)
Y = runif(N, -1, 1)
# Unit Circle formula = x^2 + y^2 = 1
# I is true if (X,Y) is in unit cricle, false otherwise
# We have a square and a circle
# area of square = 2x2 = 4 (as X and Y E(-1,1))
# area of circle = pi * r^2 but unit circle so just pi
# thus prop inside circle = area(circle)/area(square)
# Thus pi/4
# we know p = true when dot is in unit circle
# thus p = pi/4
# pi = 4p
I = (X^2 + Y^2 <= 1) # will generate T/F vector (Indicator)
phat = mean(I)
pi_hat = 4 * phat
MCSE = 4 * sd(I) / sqrt(N)
# 4 * sqrt(phat * (1-phat))/ sqrt(N) as var(I) = phat * (1-phat)
pi_hat ; MCSE
#graphing
plot(Y ~ X, col = ifelse(I, "red", "lightblue"),
pch = 16,
main = paste0("Monte carlo simulation of Pi")
)
abline(v = 0, h = 0)
symbols(0,0, circles = 1, add = T)
pi_hat ; MCSE
N = 10000
a = 0.8
b = 3
f <- function(x) 1 / (1 + sinh(2 * x) * (log(x)^2))
#U = runif(N, 0, 1)
U = runif(N,0.8,3)
Y = f(U)
# E(X) if X ~ U(a,b) = (b-a)
# We want Ihat which comes from the fucntion f
# Thus the montecarlo estimate for the integral
# We want E[f(U)]
# usually Ihat = mean(Y) but must accoutn that U ~ Uni(0,1)
# usually MCSE = sd(Y)/sqrt(N) but must accoutn for U ~ uni(0,1)
Ihat = (b-a) * mean(Y)
MCSE = (b-a) * sd(Y) / sqrt(N)
# In the above we usually use MCMs to approx from 0-1, if from a-b do as above
Ihat ; MCSE
N = 10000
a = 0.8
b = 3
f <- function(x) 1 / (1 + sinh(2 * x) * (log(x)^2))
U = runif(N, 0, 1)
#U = runif(N,0.8,3)
Y = f(U)
# E(X) if X ~ U(a,b) = (b-a)
# We want Ihat which comes from the fucntion f
# Thus the montecarlo estimate for the integral
# We want E[f(U)]
# usually Ihat = mean(Y) but must accoutn that U ~ Uni(0,1)
# usually MCSE = sd(Y)/sqrt(N) but must accoutn for U ~ uni(0,1)
Ihat = (b-a) * mean(Y)
MCSE = (b-a) * sd(Y) / sqrt(N)
# In the above we usually use MCMs to approx from 0-1, if from a-b do as above
Ihat ; MCSE
