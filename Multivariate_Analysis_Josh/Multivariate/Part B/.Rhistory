k = ncol(X_ph_w)
r = ncol(Y)
p = k - 1
q = k - ncol(X_r)
wilks = (det(full) / det(restricted))^(n/2)
Chi = -(n - k - 0.5 * (r - p + q + 1)) * log(wilks)
