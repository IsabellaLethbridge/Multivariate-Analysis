X1 = lum_response_mat_std[,1:7]
X2 = lum_response_mat_std[,8:15]
# STEP 1: Obtain covariance matrix:
S   = cov(lum_response_mat_std)
S11 = S[1:7,1:7]
S12 = S[1:7,8:15]
S21 = S[8:15,1:7]
S22 = S[8:15,8:15]
# STEP 2: Calculate R:
S11_inv = solve(S11)
S22_inv = solve(S22)
S11_eig = eigen(S11_inv)
S22_eig = eigen(S22_inv)
S11_inv_sqrt = S11_eig$vectors%*%diag(1/sqrt(S11_eig$values))%*%t(S11_eig$vectors)
S22_inv_sqrt = S22_eig$vectors%*%diag(1/sqrt(S22_eig$values))%*%t(S22_eig$vectors)
R = S11_inv_sqrt%*%S12%*%S22_inv%*%S21%*%S11_inv_sqrt
# STEP 3: Eigen decomposition:
R_eig = eigen(R)
# STEP 4: Obtain canonical correlations:
R_star = sqrt(R_eig$values)
R_star
# STEP 5: Obtain canonical coefficients:
A = S11_inv_sqrt%*%R_eig$vectors
round(A<4)
round(A,4)
# STEP 7: Obtain B (proportional):
B_p = S22_inv%*%S21%*%A
B_p
# STEP 8: Standardise B:
sf = sqrt(diag(t(B_p)%*%S22%*%B_p))
B = B_p/matrix(sf,
nrow=nrow(B_p),
ncol=ncol(B_p),
byrow=TRUE)
round(B,4)
# STEP 9: Canonical loadings:
loadings_U = A%*%S11
loadings_U
A
# STEP 9: Canonical loadings:
loadings_U = t(A)%*%S11
loadings_U
loadings_V = t(B)%*%S22
loadings_V
# STEP 10: Cross-loadings:
cross_U = t(A)%*%S12
cross_U
cross_V = t(B)%*%S21
cross_V
